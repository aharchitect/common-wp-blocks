{
	"name": "common-wp-blocks",
	"version": "0.1.0",
	"description": "Common WordPress Blocks: A collection of essential, opinionated Gutenberg blocks.",
	"author": "aharchitect",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php --output-path=build/admonition src/admonition/index.js",
		"format": "wp-scripts format",
		"test": "wp-scripts test-unit-js",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-copy-php --output-path=build/admonition src/admonition/index.js"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.27.0",
		"jest-transform-stub": "^2.0.0",
		"postcss-scss": "^4.0.9"
	},
	"dependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@wordpress/block-editor": "^15.6.0"
	},
	"stylelint": {
		"customSyntax": "postcss-scss",
		"plugins": [
			"@stylistic/stylelint-plugin"
		],
		"rules": {
			"@stylistic/indentation": 4
		}
	}
}
