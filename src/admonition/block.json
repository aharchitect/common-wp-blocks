{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "common-wp-blocks/admonition",
	"version": "0.1.0",
	"title": "Admonition (Note, Tip, Warning)",
	"category": "design",
	"icon": "info",
	"description": "A visually distinct, collapsible block for notes, tips, and warnings.",
	"example": {
		"attributes": {
			"type": "note",
			"title": "A Friendly Note",
			"isCollapsible": true,
			"isInitiallyExpanded": false
		},
		"innerBlocks": [
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Use this block to highlight important information for your readers."
				}
			}
		]
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true
		}
	},
	"attributes": {
		"type": {
			"type": "string",
			"default": "note"
		},
		"title": {
			"type": "string",
			"source": "html",
			"selector": ".admonition-title",
			"default": "Note"
		},
		"customIconData": {
			"type": "string",
			"default": ""
		},
		"isCollapsible": {
			"type": "boolean",
			"default": true
		},
		"isInitiallyExpanded": {
			"type": "boolean",
			"default": true
		},
		"enableCustomBorder": {
			"type": "boolean",
			"default": false
		},
		"customBlockBgColor": {
			"type": "string",
			"default": ""
		},
		"customHeaderBgColor": {
			"type": "string",
			"default": ""
		},
		"customHeaderTextColor": {
			"type": "string",
			"default": ""
		},
		"customBorderColor": {
			"type": "string",
			"default": ""
		},
		"customBorderWidth": {
			"type": "number",
			"default": 5
		},
		"customBorderRadius": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "common-wp-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
