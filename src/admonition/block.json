{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "common-wp-blocks/admonition",
	"version": "0.1.0",
	"title": "Admonition (Note, Tip, Warning)",
	"category": "design",
	"icon": "info",
	"description": "A visually distinct, collapsible block for notes, tips, and warnings.",
	"example": {
		"attributes": {
			"type": "note",
			"title": "A Friendly Note",
			"isCollapsible": true,
			"isInitiallyExpanded": false
		},
		"innerBlocks": [
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Use this block to highlight important information for your readers."
				}
			}
		]
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"margin": false,
				"padding": false
			}
		}
	},
	"selectors": {
		"root": ".wp-block-common-wp-blocks-admonition",
		"spacing": {
			"margin": ".wp-block-common-wp-blocks-admonition[data-is-collapsible=\"true\"] summary.admonition-header, .wp-block-common-wp-blocks-admonition[data-is-collapsible=\"false\"] .admonition-header",
			"padding": ".wp-block-common-wp-blocks-admonition[data-is-collapsible=\"true\"] summary.admonition-header, .wp-block-common-wp-blocks-admonition[data-is-collapsible=\"false\"] .admonition-header"
		}
	},
	"attributes": {
		"type": {
			"type": "string",
			"default": "note"
		},
		"title": {
			"type": "string",
			"source": "html",
			"selector": ".admonition-title",
			"default": "Note"
		},
		"customIconData": {
			"type": "string",
			"default": ""
		},
		"isCollapsible": {
			"type": "boolean",
			"default": true
		},
		"isInitiallyExpanded": {
			"type": "boolean",
			"default": true
		},
		"enableCustomBorder": {
			"type": "boolean",
			"default": false
		},
		"customBlockBgColor": {
			"type": "string",
			"default": ""
		},
		"customHeaderBgColor": {
			"type": "string",
			"default": ""
		},
		"customHeaderTextColor": {
			"type": "string",
			"default": ""
		},
		"customBorderBox": {
			"type": "object",
			"default": {
				"width": "1px"
			}
		},
		"customBorderColor": {
			"type": "string",
			"default": ""
		},
		"customBorderWidth": {
			"type": "number",
			"default": 5
		},
		"customBorderRadius": {
			"type": "number",
			"default": 0
		},
		"customBorderRadiusValues": {
			"type": "object",
			"default": {}
		}
	},
	"textdomain": "common-wp-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
